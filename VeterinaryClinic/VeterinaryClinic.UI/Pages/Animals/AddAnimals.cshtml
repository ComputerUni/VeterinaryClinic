@page
@model VeterinaryClinic.UI.Pages.Animals.AddAnimalsModel
@{
    ViewData["Title"] = "Yeni Hayvan Ekle";
    Layout = "~/Pages/Shared/_ManagerLayout.cshtml";
}

<div class="container p-4">
    <div class="form-layout-wrapper">
        <div class="row">
            <div class="col-lg-12">
                <div class="card-style mb-30">
                    <p class="text-sm mb-25">
                        Yeni hayvan kaydınızı bu kısımdan ekleyiniz.
                    </p>

                    <form method="post" class="row">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.OwnerId" class="form-label">
                                        Hayvan Sahibi
                                    </label>
                                    <select asp-for="Animal.OwnerId" asp-items="Model.CustomerSelectList" class="form-control form-select" id="animal-owner">
                                        <option value="">-- Lütfen Bir Müşteri Seçiniz --</option>
                                    </select>
                                    <span asp-validation-for="Animal.OwnerId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Name" class="form-label">
                                        Ad
                                    </label>
                                    <input asp-for="Animal.Name" type="text" class="form-control" id="animal-name">
                                    <span asp-validation-for="Animal.Name" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Age" class="form-label">
                                        Yaş
                                    </label>
                                    <input asp-for="Animal.Age" type="number" class="form-control" id="animal-age">
                                    <span asp-validation-for="Animal.Age" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Weight" class="form-label">
                                        Ağırlık
                                    </label>
                                    <input asp-for="Animal.Weight" type="number" step="0.01" class="form-control" id="animal-weight">
                                    <span asp-validation-for="Animal.Weight" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Height" class="form-label">
                                        Yükseklik
                                    </label>
                                    <input asp-for="Animal.Height" type="number" step="0.01" class="form-control" id="animal-height">
                                    <span asp-validation-for="Animal.Height" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Breed" class="form-label">
                                        Irk
                                    </label>
                                    <input asp-for="Animal.Breed" type="text" class="form-control" id="animal-breed">
                                    <span asp-validation-for="Animal.Breed" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Species" class="form-label">
                                        Tür
                                    </label>
                                    <input asp-for="Animal.Species" type="text" class="form-control" id="animal-species">
                                    <span asp-validation-for="Animal.Species" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.MedicalHistory" class="form-label">
                                        Sağlık Tarihi
                                    </label>
                                    <input asp-for="Animal.MedicalHistory" type="text" class="form-control" id="animal-medical-history">
                                    <span asp-validation-for="Animal.MedicalHistory" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-4 mb-0">
                            <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-2"></i>Hayvan Kaydını Sisteme Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>