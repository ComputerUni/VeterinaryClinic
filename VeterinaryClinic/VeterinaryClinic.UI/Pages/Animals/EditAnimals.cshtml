@page
@model VeterinaryClinic.UI.Pages.Animals.EditAnimalsModel
@{
    Layout = "~/Pages/Shared/_ManagerLayout.cshtml";
}

<div class="container p-4">
    <div class="form-layout-wrapper">
        <div class="row">
            <div class="col-lg-12">
                <div class="card-style mb-30">
                    <h6 class="mb-15">Yeni Hayvan Kaydı</h6>
                    <p class="text-sm mb-25">
                        Yeni hayvan kaydınızı bu kısımdan ekleyiniz.
                    </p>
                    <form asp-page="/Animals/EditAnimals" method="post" class="row needs-validation" novalidate="">
                        <div class="row">
                            <input type="hidden" asp-for="Animal.Id" />
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.OwnerId" class="form-label">
                                        Sahip ID
                                    </label>
                                    <input asp-for="Animal.OwnerId" type="text" class="form-control" id="f-name" required="">
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Name" class="form-label">
                                        Ad
                                    </label>
                                    <input asp-for="Animal.Name" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Age" class="form-label">
                                        Yaş
                                    </label>
                                    <input asp-for="Animal.Age" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Weight" class="form-label">
                                        Ağırlık
                                    </label>
                                    <input asp-for="Animal.Weight" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Height" class="form-label">
                                        Yükseklik
                                    </label>
                                    <input asp-for="Animal.Height" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Breed" class="form-label">
                                        Irk
                                    </label>
                                    <input asp-for="Animal.Breed" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.Species" class="form-label">
                                        Tür
                                    </label>
                                    <input asp-for="Animal.Species" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Animal.MedicalHistory" class="form-label">
                                        Sağlık Tarihi
                                    </label>
                                    <input asp-for="Animal.MedicalHistory" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-4 mb-0">
                            <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-2"></i>Hayvan Kaydını Sisteme Kaydet
                            </button>
                        </div>
                    </form>
                </div>
                <!-- end card -->
            </div>
        </div>
        <!-- end row -->
    </div>
</div>