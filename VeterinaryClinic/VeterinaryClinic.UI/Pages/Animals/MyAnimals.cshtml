@page
@model VeterinaryClinic.UI.Pages.Animals.MyAnimalsModel
@using System.Linq
@using X.PagedList;
@{
    Layout = "~/Pages/Shared/_CustomerLayout.cshtml";
}

<!-- ========== title-wrapper start ========== -->  
<div class="title-wrapper pt-30">
    <div class="row align-items-center">
        <div class="col-md-6">
            <div class="title">
                <h2>Customer Dashboard</h2>
            </div>
        </div>
        <!-- end col -->
        <div class="col-md-6">
            <div class="breadcrumb-wrapper">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#0">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            CRM
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
        <!-- end col -->
    </div>
    <!-- end row -->
</div>
<!-- ========== title-wrapper end ========== -->
<div class="row">
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-heart"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Kayıtlı Hayvan Sayım</h6>
                    <h3 class="text-bold mb-10">@(Model.MyAnimalList != null ? Model.MyAnimalList.Count() : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon success">
                    <i class="lni lni-timer"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Hayvanların Yaş Ortalaması</h6>
                    <h3 class="text-bold mb-10">@(Model.MyAnimalList != null ? Model.MyAnimalList.Average(a => a.Age).ToString("0.00") : "0.00")</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon primary">
                    <i class="lni lni-ruler"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Hayvanların Boy Ortalaması</h6>
                    <h3 class="text-bold mb-10">@(Model.MyAnimalList != null ? Model.MyAnimalList.Average(a => a.Height).ToString("0.00") : "0.00")</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
</div>
<!-- End Row -->
<!-- End Row -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-style clients-table-card mb-30">
            <div class="table-wrapper table-responsive">
                <table class="table lead-table">
                    <thead>
                        <tr>
                            <th class="image">
                                <h6>#</h6>
                            </th>
                            <th class="name">
                                <h6>Hayvan Adı</h6>
                            </th>
                            <th class="age">
                                <h6>Yaş</h6>
                            </th>
                            <th class="weight">
                                <h6>Ağırlık</h6>
                            </th>
                            <th class="height">
                                <h6>Boy</h6>
                            </th>
                            <th class="species">
                                <h6>Irk</h6>
                            </th>
                            <th class="breed">
                                <h6>Tür</h6>
                            </th>
                            <th class="transactions">
                                <h6>İşlemler</h6>
                            </th>
                        </tr>
                        <!-- end table row-->
                    </thead>
                    <tbody>
                        @foreach (var animal in Model.PagedMyAnimalList)
                        {
                            <tr>
                                <td>
                                    <p>@animal.Id</p>
                                </td>
                                <td>
                                    <p>@animal.Name</p>
                                </td>
                                <td>
                                    <p>@animal.Age</p>
                                </td>
                                <td>
                                    <p>@animal.Weight</p>
                                </td>
                                <td>
                                    <p>@animal.Height</p>
                                </td>
                                <td>
                                    <p>@animal.Species</p>
                                </td>
                                <td>
                                    <p>@animal.Breed</p>
                                </td>
                                <td>
                                    <a class="btn btn-primary btn-sm" asp-page="/Treatments/MyTreatment" asp-route-id="@animal.Id">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                                @* <td>
                                    <div>
                                        <a class="btn btn-primary" asp-page="/Animals/EditAnimals" asp-route-id="@animal.Id"><i class="fa-solid fa-pencil"></i></a>
                                    </div>
                                </td> *@
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- end table -->

            </div>
        </div>
        <!-- end card -->
    </div>
    <div class="row mt-3 mb-3">
        @for (int i = 1; i <= Model.PagedMyAnimalList.PageCount; i++)
        {
            <div class="col-auto">
                <a asp-page="/Animals/MyAnimals" asp-route-pageNumber="@i" class="btn @(i == Model.PagedMyAnimalList.PageNumber ? "btn-primary" : "btn-outlined-primary") row">@i</a>
            </div>

        }
    </div>

</div>
<!-- End Row -->
