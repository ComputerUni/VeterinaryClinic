@page
@model VeterinaryClinic.UI.Pages.Treatments.IndexModel
@{
    ViewData["Title"] = "Tüm Tedaviler";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="row">
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="fa-solid fa-stethoscope"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Toplam Tedavi Sayısı</h6>
                    <h3 class="text-bold mb-10">@(Model.TreatmentList != null ? Model.TreatmentList.Count() : 0)</h3>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card-style clients-table-card mb-30">
            <div class="title d-flex justify-content-between align-items-center">
                <h6 class="mb-10">Tedaviler</h6>
                <div class="more-btn-wrapper">
                    <button class="more-btn dropdown-toggle" id="moreAction" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="lni lni-more-alt"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="moreAction">
                        <li class="dropdown-item">
                            <a asp-page="/Treatments/AddTreatment" class="text-gray">Tedavi Ekle</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="table-wrapper table-responsive">
                <table class="table lead-table">
                    <thead>
                        <tr>
                            <th class="id"><h6>#</h6></th>
                            <th class="appointment-id"><h6>Randevu Id</h6></th>
                            <th class="treatment-type"><h6>Tedavi Türü</h6></th>
                            <th class="notes"><h6>Notlar</h6></th>
                            <th class="cost"><h6>Ücret</h6></th>
                            <th class="transactions"><h6>İşlemler</h6></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model.PagedTreatmentList)
                        {
                            <tr>
                                <td class="id">
                                    <p>@appointment.Id</p>
                                </td>
                                <td class="appointment-id">
                                    <p>@appointment.AppointmentId</p>
                                </td>
                                <td class="treatment-type">
                                    <p>@appointment.TreatmentType</p>
                                </td>
                                <td class="notes">
                                    <p>@appointment.Notes</p>
                                </td>
                                <td class="cost">
                                    <p>@appointment.Cost</p>
                                </td>
                                <td class="transactions">
                                    <div class="action-buttons">
                                        <a class="btn btn-primary btn-sm" asp-page="/Treatments/EditTreatment" asp-route-id="@appointment.Id">
                                            <i class="fa-solid fa-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
        @for (int i = 1; i <= Model.PagedTreatmentList.PageCount; i++)
        {
            <a asp-page="/Treatments/Index"
               asp-route-pageNumber="@i"
               class="btn @(i == Model.PagedTreatmentList.PageNumber ? "btn-primary" : "btn-outline-secondary")">
                @i
            </a>
        }
    </div>
</div>


