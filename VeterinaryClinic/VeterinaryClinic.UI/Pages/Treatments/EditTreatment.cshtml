@page
@model VeterinaryClinic.UI.Pages.Treatments.EditTreatmentModel
@{
    ViewData["Title"] = "Tedavi Kaydını Güncelle";
    Layout = "~/Pages/Shared/_ManagerLayout.cshtml";
}

<div class="container p-4">
    <div class="form-layout-wrapper">
        <div class="row">
            <div class="col-lg-12">
                <div class="card-style mb-30">
                    <p class="text-sm mb-25">
                        Tedavi bilgilerinizi bu kısımdan güncelleyiniz.
                    </p>
                    <form asp-page="/Treatments/EditTreatment" method="post" class="row needs-validation" novalidate="">
                        <div class="row">
                            <input type="hidden" asp-for="Treatment.Id" />
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Treatment.AppointmentId" class="form-label">
                                        Randevu ID
                                    </label>
                                    <input asp-for="Treatment.AppointmentId" type="text" class="form-control" id="f-name" required="">
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Treatment.TreatmentType" class="form-label">
                                        Tedavi Türü
                                    </label>
                                    <select asp-for="Treatment.TreatmentType" class="form-select form-control" required>
                                        <option value="">-- Tedavi Seçiniz --</option>
                                        <option value="Muayene">Muayene</option>
                                        <option value="Aşılama">Aşılama</option>
                                        <option value="Ameliyat">Ameliyat</option>
                                        <option value="Pansuman">Pansuman</option>
                                        <option value="Diş Temizliği">Diş Temizliği</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Treatment.Notes" class="form-label">
                                        Saat
                                    </label>
                                    <input asp-for="Treatment.Notes" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Treatment.Cost" class="form-label">
                                        Durum
                                    </label>
                                    <input asp-for="Treatment.Cost" type="number" class="form-control" required>
                                </div>
                                @* <div class="input-style-1">
                                    <label asp-for="Appointment.Status" class="form-label">Durum</label>
                                    <input asp-for="Appointment.Status" type="text" class="form-control" id="l-name" required="">
                                </div> *@
                            </div>
                        </div>
                        <div class="form-group mt-4 mb-0">
                            <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-2"></i>Tedavi Kaydını Sisteme Kaydet
                            </button>
                        </div>
                    </form>
                </div>
                <!-- end card -->
            </div>
        </div>
        <!-- end row -->
    </div>
</div>
