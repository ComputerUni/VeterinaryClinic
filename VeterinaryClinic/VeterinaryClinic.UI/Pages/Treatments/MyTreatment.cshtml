@page
@model VeterinaryClinic.UI.Pages.Treatments.MyTreatmentModel
@{
    ViewData["Title"] = "Hayvanlarımın Geçmiş Tedavi Bilgileri";
    Layout = "~/Pages/Shared/_CustomerLayout.cshtml";
}

<div class="row">
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-heart"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Toplam Tedavi Sayısı</h6>
                    <h3 class="text-bold mb-10">@(Model.TreatmentList != null ? Model.TreatmentList.Count() : 0)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card-style clients-table-card mb-30">
                <div class="title d-flex justify-content-between align-items-center">
                    <h6 class="mb-10">Hayvanlar</h6>
                    @* <div class="more-btn-wrapper">
                    <button class="more-btn dropdown-toggle" id="moreAction" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="lni lni-more-alt"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="moreAction">
                        <li class="dropdown-item">
                            <a asp-page="/Appointments/AddAppointment" class="text-gray">Randevu Ekle</a>
                        </li>
                    </ul>
                </div> *@
                </div>
                <div class="table-wrapper table-responsive">
                    <table class="table lead-table">
                        <thead>
                            <tr>
                                <th><h6>#</h6></th>
                                <th><h6>Randevu Id</h6></th>
                                <th><h6>Tedavi Türü</h6></th>
                                <th><h6>Notlar</h6></th>
                                <th><h6>Ücret</h6></th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.PagedMyTreatmentList)
                            {
                                <tr>
                                    <td class="image">
                                        <p>@appointment.Id</p>
                                    </td>
                                    <td class="id">
                                        <p>@appointment.AppointmentId</p>
                                    </td>
                                    <td class="date">
                                        <p>@appointment.TreatmentType</p>
                                    </td>
                                    <td class="text">
                                        <p>@appointment.Notes</p>
                                    </td>
                                    <td class="notes">
                                        <p>@appointment.Cost</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- end card -->
        </div>
    </div>

