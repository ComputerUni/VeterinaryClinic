            </div>
            <div class="table-wrapper table-responsive">
                <table class="table lead-table">
                    <thead>
                        <tr>
                            <th><h6>#</h6></th>
                            <th><h6>Randevu Id</h6></th>
                            <th><h6>Tedavi Türü</h6></th>
                            <th><h6>Notlar</h6></th>
                            <th><h6>Ücret</h6></th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model.PagedMyTreatmentList)
                        {
                            <tr>
                                <td class="image">
                                    <p>@appointment.Id</p>
                                </td>
                                <td class="id">
                                    <p>@appointment.AppointmentId</p>
                                </td>
                                <td class="date">
                                    <p>@appointment.TreatmentType</p>
                                </td>
                                <td class="text">
                                    <p>@appointment.Notes</p>
                                </td>
                                <td class="notes">
                                    <p>@appointment.Cost</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end card -->
    </div>
