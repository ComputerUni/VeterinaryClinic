@page
@model VeterinaryClinic.UI.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Pati Klinik Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <p class="text-white small mb-0">Kliniğinizin anlık günlük, aylık ciro ve operasyonel verileri.</p>
        </div>
        <div class="text-end">
            <span class="badge bg-black text-white p-2 border-0 shadow-sm">
                <i class="fa-solid fa-calendar-days text-primary me-1"></i>
                @DateTime.Now.ToString("dd MMMM yyyy")
            </span>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mb-4">

        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(40,199,111,0.15);">
                            <i class="fa-solid fa-calendar" style="color:#28c76f;font-size:1.3rem;"></i>
                        </div>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">@DateTime.Now.ToString("dd MMMM yyyy")</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">@DateTime.Today.ToString("dddd", new System.Globalization.CultureInfo("tr-TR"))</h3>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(40,199,111,0.15);">
                            <i class="fa-solid fa-wallet" style="color:#28c76f;font-size:1.3rem;"></i>
                        </div>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Bugünkü Ciro</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">@Model.ReportData.DailyRevenue.ToString("C2")</h3>
                    <div class="mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
                        <small style="color:#718096;font-size:0.72rem;"><i class="fa-solid fa-clock me-1"></i>Son güncelleme: @DateTime.Now.ToString("HH:mm")</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(0,123,255,0.15);">
                            <i class="fa-solid fa-coins" style="color:#007bff;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(0,123,255,0.15);color:#007bff;font-size:0.7rem;">
                            <i class="fa-solid fa-calendar me-1"></i>@DateTime.Now.ToString("MMMM")
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Bu Ayın Cirosu</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">@Model.ReportData.MonthlyRevenue.ToString("C2")</h3>
                    <div class="mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
                        <small style="color:#718096;font-size:0.72rem;"><i class="fa-solid fa-chart-line me-1"></i>@DateTime.Now.ToString("yyyy") yılı @DateTime.Now.ToString("MMMM") ayı</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(255,193,7,0.15);">
                            <i class="fa-solid fa-notes-medical" style="color:#ffc107;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(255,193,7,0.15);color:#ffc107;font-size:0.7rem;">
                            <i class="fa-solid fa-stethoscope me-1"></i>Aktif
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Bugünkü Randevular</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.DailyAppointmentsCount
                        <span class="fs-6 fw-normal" style="color:#718096;">Adet</span>
                    </h3>
                    <div class="mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
                        <small style="color:#718096;font-size:0.72rem;"><i class="fa-solid fa-list-check me-1"></i>Bu ay: @Model.ReportData.MonthlyAppointmentCount randevu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(23,162,184,0.15);">
                            <i class="fa-solid fa-paw" style="color:#17a2b8;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(23,162,184,0.15);color:#17a2b8;font-size:0.7rem;">
                            <i class="fa-solid fa-database me-1"></i>Toplam
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Kayıtlı Can Dostlarımız</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.TotalAnimalsCount
                        <span class="fs-6 fw-normal" style="color:#718096;">Hasta</span>
                    </h3>
                    <div class="mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
                        <small style="color:#718096;font-size:0.72rem;"><i class="fa-solid fa-shield-heart me-1"></i>Aktif hasta kaydı</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(23,162,184,0.15);">
                            <i class="fa-solid fa-credit-card" style="color:#a78bfa;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(23,162,184,0.15);color:#17a2b8;font-size:0.7rem;">
                            <i class="fa-solid fa-credit-card me-1"></i>
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Toplam Kredi Kartı Ödemeleri</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.TotalCreditCardCount
                    </h3>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(23,162,184,0.15);">
                            <i class="fa-solid fa-building-columns" style="color:#f59e0b;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(23,162,184,0.15);color:#17a2b8;font-size:0.7rem;">
                            <i class="fa-solid fa-building-columns me-1"></i>
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Toplam Havale/EFT Ödemeleri</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.TotalBankTransferCount
                    </h3>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(23,162,184,0.15);">
                            <i class="fa-solid fa-money-bill-wave" style="color:#34d399;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(23,162,184,0.15);color:#17a2b8;font-size:0.7rem;">
                            <i class="fa-solid fa-money-bill-wave me-1"></i>
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Toplam Nakit Ödemeleri</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.TotalCashCount
                    </h3>
                </div>
            </div>
        </div>
         <div class="col">
            <div class="card h-100 border-0 shadow" style="background:rgba(167,139,250,0.15);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(23,162,184,0.15);">
                            <i class="fa-solid fa-receipt" style="color:#a78bfa;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(23,162,184,0.15);color:#17a2b8;font-size:0.7rem;">
                            <i class="fa-solid fa-receipt me-1"></i>
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Nakit Kartla Ödenen Toplam Miktar</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.TotalAmountCreditCard
                    </h3>
                </div>
            </div>
        </div>
         <div class="col">
            <div class="card h-100 border-0 shadow" style="background:rgba(245,158,11,0.15);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(23,162,184,0.15);">
                            <i class="fa-solid fa-money-bill-transfer" style="color:#f59e0b;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(23,162,184,0.15);color:#17a2b8;font-size:0.7rem;">
                            <i class="fa-solid fa-money-bill-transfer me-1"></i>
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Havale/EFT ile Ödenen Toplam Miktar</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.TotalAmountBankTransfer
                    </h3>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 border-0 shadow" style="background:rgba(52,211,153,0.15);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:rgba(23,162,184,0.15);">
                            <i class="fa-solid fa-sack-dollar" style="color:#34d399;font-size:1.3rem;"></i>
                        </div>
                        <span class="badge rounded-pill px-3 py-1" style="background:rgba(23,162,184,0.15);color:#17a2b8;font-size:0.7rem;">
                            <i class="fa-solid fa-sack-dollar me-1"></i>
                        </span>
                    </div>
                    <p class="mb-1" style="color:#a0aec0;font-size:0.78rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">Nakitle Ödenen Toplam Miktar</p>
                    <h3 class="mb-0 fw-bold" style="color:#fff;">
                        @Model.ReportData.TotalAmountCash
                    </h3>
                </div>
            </div>
        </div>

    </div>
</div>