@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("Head")
<body class="dark-theme">
    <div id="preloader">
        <div class="spinner"></div>
    </div>
    <aside class="sidebar-nav-wrapper">
        <div class="navbar-logo">
            <a asp-page="/Dashboard">
                <span style="font-size: 1.5rem; font-weight: bold; color: white;">
                    <i class="fa-solid fa-paw"></i> VetClinic
                </span>
            </a>
        </div>
        @await Component.InvokeAsync("Sidebar")
    </aside>
    <div class="overlay"></div>
    <main class="main-wrapper">
        @await Component.InvokeAsync("Header")
        <section class="section">
            <div class="container-fluid">
                <div class="title-wrapper pt-30">
                    <div class="row align-items-center">
                        <div class="col-md-12">
                            <div class="title">
                                <h2>@ViewData["Title"]</h2>
                            </div>
                        </div>
                    </div>
                </div>
                @RenderBody()
            </div>
        </section>
        @await Component.InvokeAsync("Footer")
    </main>
    <button class="option-btn">
        <i class="lni lni-cog"></i>
    </button>
    <div class="option-overlay"></div>
    <div class="option-box">
        <div class="option-header">
            <div>
                <h5>Düzenleyici</h5>
            </div>
            <button class="option-btn-close text-gray">
                <i class="lni lni-close"></i>
            </button>
        </div>
        <h6 class="mb-10">Kenar</h6>
        <ul class="mb-30">
            <li><button class="leftSidebarButton active">Sol Kenar</button></li>
            <li><button class="rightSidebarButton">Sağ Kenar</button></li>
        </ul>

        <h6 class="mb-10">Tema</h6>
        <ul class="d-flex flex-wrap align-items-center">
            <li><button class="darkThemeButton">Dark Theme + Sidebar 1</button></li>
        </ul>
    </div>
    <script src="~/demo.plainadmin.com/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/Chart.min.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/apexcharts.min.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/dynamic-pie-chart.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/moment.min.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/fullcalendar.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/jvectormap.min.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/world-merc.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/polyfill.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/quill.min.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/datatable.js"></script>
    <script src="~/demo.plainadmin.com/assets/js/Sortable.min.js"></script>
    <script>
        localStorage.setItem('theme', 'dark');
    </script>
    <script src="~/demo.plainadmin.com/assets/js/main.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>