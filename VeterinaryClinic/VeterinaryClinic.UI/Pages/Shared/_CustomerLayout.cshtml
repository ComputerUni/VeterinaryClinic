@{
    Layout = "_DashboardLayout";
}

@section Sidebar {
    <nav class="sidebar-nav">
        <ul>
            <li class="nav-item">
                <a asp-page="/Dashboard/Index">
                    <span class="icon"><i class="fa-solid fa-house"></i></span>
                    <span class="text">Dashboard</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Animals/MyAnimals">
                    <span class="icon"><i class="fa-solid fa-paw"></i></span>
                    <span class="text">Hayvanlarım</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-page="/Appointments/MyAppointment">
                    <span class="icon"><i class="fa-solid fa-calendar-check"></i></span>
                    <span class="text">Randevularım</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-page="/Payments/MyPayments">
                    <span class="icon"><i class="fa-solid fa-credit-card"></i></span>
                    <span class="text">Ödemelerim</span>
                </a>
            </li>
            <li class="nav-item">
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="nav-logout-btn">
                        <span class="icon"><i class="fa-solid fa-right-from-bracket"></i></span>
                        <span class="text">Çıkış Yap</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>
}

@RenderBody()