@{
    Layout = "_DashboardLayout";
}

@section Sidebar {
    <nav class="sidebar-nav">
        <ul>
            <li class="nav-item">
                <a asp-page="/Dashboard/Index">
                    <span class="icon"><i class="fa-solid fa-paw"></i></span>
                    <span class="text">Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a asp-page="/Animals/Animals">
                    <span class="icon"><i class="fa-solid fa-paw"></i></span>
                    <span class="text">Hayvanlar</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Appointments/Index">
                    <span class="icon"><i class="fa-solid fa-calendar-check"></i></span>
                    <span class="text">Randevular</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Treatments/Index">
                    <span class="icon"><i class="fa-solid fa-calendar-check"></i></span>
                    <span class="text">Tedaviler</span>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Payments/Index">
                    <span class="icon"><i class="fa-solid fa-calendar-check"></i></span>
                    <span class="text">Ödemeler</span>
                </a>
            </li>

            <li class="nav-item">
                <form method="post" asp-page="/Logout" style="display: block; width: 100%;">
                    <button type="submit" class="nav-logout-btn" style="display: flex; align-items: center; width: 100%; background: none; border: none; padding: 0; color: inherit; font: inherit; text-align: left; cursor: pointer;">
                        <span class="icon"><i class="fa-solid fa-right-from-bracket"></i></span>
                        <span class="text">Çıkış Yap</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>
}

@RenderBody()