@page
@model VeterinaryClinic.UI.Pages.Appointments.IndexModel
@using VeterinaryClinic.Entities.Status
@{
    ViewData["Title"] = "Randevular";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}
<div class="row">
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Toplam Tedavi Sayısı</h6>
                    <h3 class="text-bold mb-10">@(Model.AppointmentList != null ? Model.AppointmentList.Count() : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon success">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Bekleyen Tedaviler</h6>
                    <h3 class="text-bold mb-10">@(Model.AppointmentList != null ? Model.AppointmentList.Count(a => a.Status == AppointmentStatus.Scheduled) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon primary">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Kabul Edilen Tedaviler</h6>
                    <h3 class="text-bold mb-10">@(Model.AppointmentList != null ? Model.AppointmentList.Count(a => a.Status == AppointmentStatus.Completed) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon primary">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">İptal Edilen Tedaviler</h6>
                    <h3 class="text-bold mb-10">@(Model.AppointmentList != null ? Model.AppointmentList.Count(a => a.Status == AppointmentStatus.Cancelled) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
</div>
<form method="get" asp-page="/Appointments/Index" class="d-flex gap-2">
    <select name="statusFilter" class="form-control form-control-sm" style="width:400px; appearance: none; padding-right: 32px;">
        <option value="">Tümü</option>
        <option value="Scheduled" selected="@(Model.StatusFilter == "Scheduled")">Bekleyenler</option>
        <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Tamamlananlar</option>
        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">İptal Edilenler</option>
    </select>
    <button type="submit" class="btn btn-sm btn-primary">
        <i class="fa-solid fa-filter"></i>
    </button>
</form>
<div class="row">
    <div class="col-lg-12">
        <div class="card-style clients-table-card mb-30">
            <div class="title d-flex justify-content-between align-items-center">
                <h6 class="mb-10">Hayvanlar</h6>
                <div class="more-btn-wrapper">
                    <button class="more-btn dropdown-toggle" id="moreAction" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="lni lni-more-alt"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="moreAction">
                        <li class="dropdown-item">
                            <a asp-page="/Appointments/AddAppointment" class="text-gray">Randevu Ekle</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="table-wrapper table-responsive">
                <table class="table lead-table">
                    <thead>
                        <tr>
                            <th class="image"><h6>#</h6></th>
                            <th class="id"><h6>Animal Id</h6></th>
                            <th class="date"><h6>Tarih</h6></th>
                            <th class="time"><h6>Saat</h6></th>
                            <th class="status"><h6>Durum</h6></th>
                            <th class="notes"><h6>Notlar</h6></th>
                            <th class="transactions"><h6>İşlemler</h6></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model.PagedAppointmentList)
                        {
                            <tr>
                                <td class="image">
                                    <p>@appointment.Id</p>
                                </td>
                                <td class="id">
                                    <p>@appointment.AnimalId</p>
                                </td>
                                <td class="date">
                                    <p>@appointment.Date</p>
                                </td>
                                <td class="time">
                                    <p>@appointment.Time</p>
                                </td>
                                <td class="status">
                                    @if (appointment.Status == AppointmentStatus.Scheduled)
                                    {
                                        <span class="badge bg-warning">Bekliyor</span>
                                    }
                                    else if (appointment.Status == AppointmentStatus.Completed)
                                    {
                                        <span class="badge bg-success">Tamamlandı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">İptal Edildi</span>
                                    }
                                </td>
                                <td class="notes">
                                    <p>@appointment.Notes</p>
                                </td>
                                <td class="transactions">
                                    <div class="action-buttons">
                                        <a class="btn btn-primary btn-sm" asp-page="/Appointments/EditAppointment" asp-route-id="@appointment.Id">
                                            <i class="fa-solid fa-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end card -->
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
        @for (int i = 1; i <= Model.PagedAppointmentList.PageCount; i++)
        {
            <a asp-page="/Appointments/Index"
               asp-route-pageNumber="@i"
               class="btn @(i == Model.PagedAppointmentList.PageNumber ? "btn-primary" : "btn-outline-secondary")">
                @i
            </a>
        }
    </div>
</div>
<!-- End Row -->
