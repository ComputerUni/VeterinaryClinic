@page
@model VeterinaryClinic.UI.Pages.Appointments.EditAppointmentModel
@using VeterinaryClinic.Entities.Status
@{
    ViewData["Title"] = "Randevu Kaydını Güncelle";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}


<div class="container p-4">
    <div class="form-layout-wrapper">
        <div class="row">
            <div class="col-lg-12">
                <div class="card-style mb-30">
                    <p class="text-sm mb-25">
                        Randevu bilgilerinizi bu kısımdan güncelleyiniz.
                    </p>
                    <form asp-page="/Appointments/EditAppointment" method="post" class="row needs-validation" novalidate="">
                        <div class="row">
                            <input type="hidden" asp-for="Appointment.Id" />
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.AnimalId" class="form-label">
                                        Hayvan ID
                                    </label>
                                    <input asp-for="Appointment.AnimalId" type="text" class="form-control" id="f-name" required="">
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.Date" class="form-label">
                                        Tarih
                                    </label>
                                    <input asp-for="Appointment.Date" type="date" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.Time" class="form-label">
                                        Saat
                                    </label>
                                    <input asp-for="Appointment.Time" type="time" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.Status" class="form-label">
                                        Durum
                                    </label>
                                    <select asp-for="Appointment.Status" class="form-select form-control" required="" asp-items="Html.GetEnumSelectList<AppointmentStatus>()"></select>
                                </div>
                                @* <div class="input-style-1">
                                    <label asp-for="Appointment.Status" class="form-label">Durum</label>
                                    <input asp-for="Appointment.Status" type="text" class="form-control" id="l-name" required="">
                                </div> *@
                            </div>
                        </div>

                            <div class="col-md-12">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.Notes" class="form-label">
                                        Notlar
                                    </label>
                                    <input asp-for="Appointment.Notes" type="text" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>

                        <div class="form-group mt-4 mb-0">
                            <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-2"></i>Hayvan Kaydını Sisteme Kaydet
                            </button>
                        </div>
                    </form>
                </div>
                <!-- end card -->
            </div>
        </div>
        <!-- end row -->
    </div>
</div>