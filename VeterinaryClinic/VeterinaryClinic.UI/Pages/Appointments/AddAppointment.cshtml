@page
@model VeterinaryClinic.UI.Pages.Appointments.AddAppointmentModel
@using VeterinaryClinic.Entities.Status
@{
    ViewData["Title"] = "Yeni Randevu Ekle";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}


<div class="container p-4">
    <div class="form-layout-wrapper">
        <div class="row">
            <div class="col-lg-12">
                <div class="card-style mb-30">
                    <p class="text-sm mb-25">
                        Yeni randevu kaydınızı bu kısımdan ekleyiniz.
                    </p>
                    <form method="post" class="row">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.AnimalId" class="form-label">
                                        Hayvan Seçiniz
                                    </label>
                                    <select asp-for="Appointment.AnimalId" class="form-select form-control">
                                        <option value="">-- Hayvan Seçiniz --</option>
                                        @foreach (var animal in Model.MyAnimals)
                                        {
                                            <option value="@animal.Id">@animal.Name (@animal.Species)</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Appointment.AnimalId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.Date" class="form-label">
                                        Tarih
                                    </label>
                                    <input asp-for="Appointment.Date" type="date" class="form-control" id="appointment-date">
                                    <span asp-validation-for="Appointment.Date" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @if (User.IsInRole("Manager"))
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="input-style-1">
                                        <label asp-for="Appointment.Time" class="form-label">
                                            Saat
                                        </label>
                                        <input asp-for="Appointment.Time" type="time" class="form-control" id="appointment-time">
                                        <span asp-validation-for="Appointment.Time" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">

                                    <div class="input-style-1">
                                        <label asp-for="Appointment.Status" class="form-label">
                                            Durum
                                        </label>
                                        <select asp-for="Appointment.Status" class="form-select form-control" id="appointment-status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()"></select>
                                        <span asp-validation-for="Appointment.Status" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="input-style-1">
                                    <label asp-for="Appointment.Time" class="form-label">
                                        Saat
                                    </label>
                                    <input asp-for="Appointment.Time" type="time" class="form-control" id="appointment-time">
                                    <span asp-validation-for="Appointment.Time" class="text-danger"></span>
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <div class="input-style-1">
                                <label asp-for="Appointment.Notes" class="form-label">
                                    Notlar
                                </label>
                                <input asp-for="Appointment.Notes" type="text" class="form-control" id="appointment-notes">
                                <span asp-validation-for="Appointment.Notes" class="text-danger"></span>
                            </div>
                        </div>


                        <div class="form-group mt-4 mb-0">
                            <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-2"></i> Randevu Kaydını Sisteme Kaydet
                            </button>
                        </div>
                    </form>
                </div>
                <!-- end card -->
            </div>
        </div>
        <!-- end row -->
    </div>
</div>