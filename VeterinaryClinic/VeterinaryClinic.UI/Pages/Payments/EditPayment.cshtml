@page
@model VeterinaryClinic.UI.Pages.Payments.EditPaymentModel
@{
    Layout = "~/Pages/Shared/_ManagerLayout.cshtml";
}



<div class="container p-4">
    <div class="form-layout-wrapper">
        <div class="row">
            <div class="col-lg-12">
                <div class="card-style mb-30">
                    <h6 class="mb-15">Yeni Tedavi Kaydı</h6>
                    <p class="text-sm mb-25">
                        Ödeme bilgilerinizi bu kısımdan güncelleyiniz.
                    </p>
                    <form asp-page="/Payments/EditPayment" asp-route-id="Id" method="post" class="row needs-validation" novalidate="">
                        <div class="row">
                            <input type="hidden" asp-for="Payment.Id" />
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Payment.AppointmentId" class="form-label">
                                        Randevu Seçiniz
                                    </label>
                                    <select asp-for="Payment.AppointmentId" class="form-select form-control" required="">
                                        <option value="">-- Randevu Seçiniz --</option>
                                        @foreach (var appointment in Model.AppointmentList)
                                        {
                                            <option value="@appointment.Id">@appointment.Id - @appointment.Date.ToShortDateString() - @appointment.Notes</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Payment.PaymentMethod" class="form-label">
                                        Randevu Seçiniz
                                    </label>
                                    <select asp-for="Payment.PaymentMethod" class="form-select form-control" required="" asp-items="Html.GetEnumSelectList<PaymentStatus>()"></select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Payment.AmountPaid" class="form-label">
                                        Ödenen Tutar
                                    </label>
                                    <input asp-for="Payment.AmountPaid" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="input-style-1">
                                    <label asp-for="Payment.PaymentDate" class="form-label">
                                        Ödeme Tarihi
                                    </label>
                                    <input asp-for="Payment.PaymentDate" class="form-control" id="l-name" required="">

                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-4 mb-0">
                            <button type="submit" class="btn btn-primary btn-block py-2 font-weight-bold shadow-sm">
                                <i class="fas fa-save mr-2"></i> Ödeme Kaydını Güncelle
                            </button>
                        </div>
                    </form>
                </div>
                <!-- end card -->
            </div>
        </div>
        <!-- end row -->
    </div>
</div>
