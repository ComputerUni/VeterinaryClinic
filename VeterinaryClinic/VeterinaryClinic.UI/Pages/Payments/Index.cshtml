@page
@model VeterinaryClinic.UI.Pages.Payments.IndexModel

@{
    ViewData["Title"] = "Ödeme Kayıtları";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<!-- ========== title-wrapper end ========== -->
<div class="row">
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-money-location"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Toplam Gelir</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Sum(p => p.AmountPaid).ToString("C") : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-wallet"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Nakit Ödemeler</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Count(p => p.PaymentMethod == PaymentStatus.Cash) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-visa"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Kredi Kartı Ödemeler</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Count(p => p.PaymentMethod == PaymentStatus.CreditCard) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="fa-solid fa-building-columns"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Havale Ödemeler</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Count(p => p.PaymentMethod == PaymentStatus.BankTransfer) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Icon Cart -->
</div>
<form method="get" asp-page="/Payments/Index" class="d-flex gap-2">
    <select name="statusFilter" class="form-control form-control-sm" style="width:400px;">
        <option value="">Tümü</option>
        <option value="Cash" selected="@(Model.StatusFilter == "Cash")">Nakit</option>
        <option value="CreditCard" selected="@(Model.StatusFilter == "CreditCard")">Kredi Kartı</option>
        <option value="BankTransfer" selected="@(Model.StatusFilter == "BankTransfer")">Havale</option>
    </select>
    <button type="submit" class="btn btn-sm btn-primary">
        <i class="fa-solid fa-filter"></i>
    </button>
</form>
<div class="row">
    <div class="col-12">
        <div class="card-style clients-table-card mb-30">
            <div class="title d-flex justify-content-between align-items-center">
                <h6 class="mb-10">Ödemeler</h6>
                <div class="more-btn-wrapper">
                    <button class="more-btn dropdown-toggle" id="moreAction" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="lni lni-more-alt"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="moreAction">
                        <li class="dropdown-item">
                            <a asp-page="/Payments/AddPayment" class="text-gray">Ödeme Ekle</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="table-wrapper table-responsive">
                <table class="table lead-table">
                    <thead>
                        <tr>
                            <th class="image"><h6>#</h6></th>
                            <th class="id"><h6>Randevu Id</h6></th>
                            <th class="date"><h6>Ödeme Miktarı</h6></th>
                            <th class="time"><h6>Ödeme Tarihi</h6></th>
                            <th class="status"><h6>Ödeme Türü</h6></th>
                            <th class="transactions"><h6>İşlemler</h6></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.PagedPaymentList)
                        {
                            <tr>
                                <td class="image">
                                    <p>@payment.Id</p>
                                </td>
                                <td class="id">
                                    <p>@payment.AppointmentId</p>
                                </td>
                                <td class="date">
                                    <p>@payment.AmountPaid</p>
                                </td>
                                <td class="time">
                                    <p>@payment.PaymentDate</p>
                                </td>
                                <td class="status">
                                    @if (payment.PaymentMethod == PaymentStatus.Cash)
                                    {
                                        <span class="badge bg-warning">Nakit</span>
                                    }
                                    else if (payment.PaymentMethod == PaymentStatus.CreditCard)
                                    {
                                        <span class="badge bg-success">Kredi Kartı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Havale</span>
                                    }
                                </td>
                                <td class="transactions">
                                    <div class="action-buttons">
                                        <a class="btn btn-primary btn-sm" asp-page="/Payments/EditPayment" asp-route-id="@payment.Id">
                                            <i class="fa-solid fa-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3 mb-3">
        @for (int i = 1; i <= Model.PagedPaymentList.PageCount; i++)
        {
            <a asp-page="/Payments/Index"
               asp-route-pageNumber="@i"
               class="btn @(i == Model.PagedPaymentList.PageNumber ? "btn-primary" : "btn-outline-secondary")">
                @i
            </a>
        }
    </div>
</div>