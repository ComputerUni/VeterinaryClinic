@page
@model VeterinaryClinic.UI.Pages.Payments.MyPaymentsModel
@{
    ViewData["Title"] = "Ödemelerim";
    Layout = "~/Pages/Shared/_CustomerLayout.cshtml";
}

<div class="row">
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-heart"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Toplam Ödeme Miktarı</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Sum(p => p.AmountPaid).ToString("C") : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-heart"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Nakit Ödemeleri</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Count(p => p.PaymentMethod == PaymentStatus.Cash) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-heart"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Kredi Kartı Ödemeleri</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Count(p => p.PaymentMethod == PaymentStatus.CreditCard) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card icon-card-2 mb-30">
            <div class="d-flex align-items-center">
                <div class="icon purple">
                    <i class="lni lni-heart"></i>
                </div>
                <div class="content">
                    <h6 class="mb-10">Havale/EFT Ödemeleri</h6>
                    <h3 class="text-bold mb-10">@(Model.PaymentList != null ? Model.PaymentList.Count(p => p.PaymentMethod == PaymentStatus.BankTransfer) : 0)</h3>
                </div>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
</div>
<!-- End Row -->
<!-- End Row -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-style clients-table-card mb-30">
            <div class="title d-flex justify-content-between align-items-center">
                <h6 class="mb-10">Hayvanlar</h6>
                @* <div class="more-btn-wrapper">
                    <button class="more-btn dropdown-toggle" id="moreAction" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="lni lni-more-alt"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="moreAction">
                        <li class="dropdown-item">
                            <a asp-page="/Appointments/AddAppointment" class="text-gray">Randevu Ekle</a>
                        </li>
                    </ul>
                </div> *@
            </div>
            <div class="table-wrapper table-responsive">
                <table class="table lead-table">
                    <thead>
                        <tr>
                            <th class="image"><h6>#</h6></th>
                            <th class="id"><h6>Randevu Id</h6></th>
                            <th class="date"><h6>Ödeme Miktarı</h6></th>
                            <th class="time"><h6>Ödeme Tarihi</h6></th>
                            <th class="status"><h6>Ödeme Türü</h6></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.PagedMyPaymentList)
                        {
                            <tr>
                                <td class="image">
                                    <p>@payment.Id</p>
                                </td>
                                <td class="id">
                                    <p>@payment.AppointmentId</p>
                                </td>
                                <td class="date">
                                    <p>@payment.AmountPaid</p>
                                </td>
                                <td class="time">
                                    <p>@payment.PaymentDate</p>
                                </td>
                                <td class="status">
                                    @if (payment.PaymentMethod == PaymentStatus.Cash)
                                    {
                                        <span class="badge bg-warning">Nakit</span>
                                    }
                                    else if (payment.PaymentMethod == PaymentStatus.CreditCard)
                                    {
                                        <span class="badge bg-success">Kredi Kartı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Havale</span>
                                    }
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="row mt-3 mb-3">
                @for (int i = 1; i <= Model.PagedMyPaymentList.PageCount; i++)
                {
                    <div class="col-auto">
                        <a asp-page="/Appointments/MyAppointments" asp-route-pageNumber="@i" class="btn @(i == Model.PagedMyPaymentList.PageNumber ? "btn-warning" : "btn-outlined-warning") row">@i</a>
                    </div>

                }
            </div>
        </div>
        <!-- end card -->
    </div>
    

</div>
