@page
@{
    ViewData["Title"] = "Erişim Reddedildi";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 - Erişim Reddedildi</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: #0d1117;
            color: #c9d1d9;
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .bg-number {
            position: fixed;
            font-size: clamp(200px, 35vw, 420px);
            font-weight: 900;
            color: rgba(255, 80, 80, 0.04);
            user-select: none;
            pointer-events: none;
            letter-spacing: -0.05em;
            line-height: 1;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 0;
        }

        .container {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 2rem;
            max-width: 520px;
        }

        .icon-wrap {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }

        .icon-wrap i {
            font-size: 1.75rem;
            color: #ef4444;
        }

        .code {
            font-size: 4.5rem;
            font-weight: 800;
            color: #ef4444;
            line-height: 1;
            margin-bottom: 0.5rem;
            letter-spacing: -0.03em;
        }

        .title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #e6edf3;
            margin-bottom: 0.75rem;
        }

        .description {
            font-size: 0.9rem;
            color: #8b949e;
            line-height: 1.65;
            margin-bottom: 2rem;
        }

        .divider {
            width: 40px;
            height: 2px;
            background: rgba(239, 68, 68, 0.4);
            margin: 1.25rem auto;
            border-radius: 2px;
        }

        .actions {
            display: flex;
            gap: 0.75rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.25rem;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
        }

        .btn-primary {
            background: #1f6feb;
            color: #fff;
        }

        .btn-primary:hover {
            background: #388bfd;
            color: #fff;
        }

        .btn-ghost {
            background: transparent;
            color: #8b949e;
            border: 1px solid #30363d;
        }

        .btn-ghost:hover {
            border-color: #8b949e;
            color: #c9d1d9;
        }

        .paw-dots {
            position: fixed;
            opacity: 0.03;
            font-size: 1.2rem;
            pointer-events: none;
            color: #fff;
        }
    </style>
</head>
<body>

    <span class="bg-number">403</span>

    <i class="fa-solid fa-paw paw-dots" style="top:12%; left:8%; transform:rotate(-20deg)"></i>
    <i class="fa-solid fa-paw paw-dots" style="top:75%; left:85%; transform:rotate(15deg)"></i>
    <i class="fa-solid fa-paw paw-dots" style="top:60%; left:5%; transform:rotate(35deg)"></i>
    <i class="fa-solid fa-paw paw-dots" style="top:20%; left:88%; transform:rotate(-10deg)"></i>

    <div class="container">
        <div class="icon-wrap">
            <i class="fa-solid fa-lock"></i>
        </div>

        <div class="code">403</div>
        <div class="title">Erişim Reddedildi</div>

        <div class="divider"></div>

        <p class="description">
            Bu sayfayı görüntülemek için gerekli yetkiye sahip değilsiniz.<br />
            Farklı bir hesapla giriş yapmayı deneyin.
        </p>

        <div class="actions">
            <a href="javascript:history.back()" class="btn btn-ghost">
                <i class="fa-solid fa-arrow-left"></i> Geri Dön
            </a>
            <a href="/Logout" class="btn btn-primary">
                <i class="fa-solid fa-right-from-bracket"></i> Çıkış Yap
            </a>
        </div>
    </div>

</body>
</html>
